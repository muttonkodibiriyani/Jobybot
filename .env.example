# ─── REQUIRED: Your Identity ──────────────────────────────────────
USER_NAME="Your Full Name"
USER_EMAIL=you@gmail.com
USER_PHONE=+971501234567
USER_LINKEDIN=https://linkedin.com/in/your-profile
USER_LOCATION="Dubai, UAE"
USER_VISA="UAE Resident Visa"
USER_NOTICE="1 month"
RESUME_PATH=./resume.pdf

# Brief summary used in cover letters (1-2 sentences about you)
USER_SUMMARY="7+ years building data products and AI solutions in MENA retail. Azure certified. IIT graduate. Dubai-based, available in 1 month."

# ─── REQUIRED: Gmail SMTP ─────────────────────────────────────────
# Generate at: https://myaccount.google.com/apppasswords
# (You must have 2FA enabled on your Google account)
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ─── Target Roles ─────────────────────────────────────────────────
# Comma-separated list of titles you want
TARGET_TITLES="Product Manager,Senior Product Manager,Data Product Manager,AI Product Manager,Senior Business Analyst,Technical Product Owner,Solution Architect,Digital Transformation Manager"

# ─── Markets ──────────────────────────────────────────────────────
PRIMARY_MARKET=UAE
# Comma-separated countries you'd also accept.
# Supported: Saudi, Qatar, Oman, Bahrain, India, Singapore, Australia,
# Canada, Germany, Netherlands, Ireland, Sweden, UK. (Germany/NL/IE/SE
# are full GDPR-strict; UK has a hybrid mode that emails only the
# legitimate-interest contacts published on job posts. Search runs in
# every market regardless — only the email blast is gated.)
SECONDARY_MARKETS="Saudi,Qatar,Oman,Bahrain,India,Singapore,Australia,Canada,UK,Germany,Netherlands,Ireland"

# ─── Rate Limits & Behaviour ──────────────────────────────────────
# Gmail consumer hard cap is 500/day. Anything above ~50 unsolicited
# recipients/day flips you into the spam-classifier bucket and starts
# quarantining sends. 50 is the safe ceiling for *cold* outreach.
# Workspace accounts can push higher only after a 2-3 week warm-up.
# See: https://support.google.com/mail/answer/22839
DAILY_EMAIL_CAP=50
HOURLY_JOB_LIMIT=20
MATCH_THRESHOLD=50

# When True, the bot DOES NOT send emails. It writes every would-be email
# to the pending_emails table and you review/edit/send each one from the
# Review Queue UI at http://localhost:7868 (start with REVIEW_QUEUE.bat).
# Recommended ON — protects your sender reputation and gives you final
# say on every outbound message.
DRAFT_MODE=true
QUEUE_SERVER_PORT=7868

# ─── LinkedIn Easy Apply (OPT-IN, OFF BY DEFAULT) ─────────────────
# IMPORTANT: LinkedIn ToS §8.2 forbids automating actions on the
# platform. Enabling this puts your LinkedIn account at risk of
# restriction. Defaults are conservative:
#   • OFF unless you explicitly flip ENABLE_EASY_APPLY=true
#   • DRY-RUN: fills the form, does NOT click Submit until you change it
#   • 10 applications/day hard cap
#   • Browser window stays visible so you can stop it
#
# Read https://jobybots.com/easy-apply BEFORE setting these.
ENABLE_EASY_APPLY=false
EASY_APPLY_DRY_RUN=true
EASY_APPLY_HEADLESS=false
EASY_APPLY_DAILY_CAP=10
EASY_APPLY_MIN_DELAY_SEC=20
EASY_APPLY_MAX_DELAY_SEC=60
EASY_APPLY_FILTER_DATE_POSTED=r604800   # r86400=24h, r604800=7d, r2592000=30d
EASY_APPLY_EXP_LEVELS=2,3,4              # 1=intern,2=entry,3=assoc,4=mid-sr,5=director
EASY_APPLY_SKIP_COMPANIES=
EASY_APPLY_REQUIRED_KEYWORDS=
EASY_APPLY_SKIP_KEYWORDS=us citizen,security clearance,senior director
EASY_APPLY_MAX_YEARS=8

# Profile defaults pulled into Easy Apply form questions.
PROFILE_YEARS_EXPERIENCE=7
PROFILE_AUTHORIZED_TO_WORK=true
PROFILE_REQUIRE_SPONSORSHIP=false
PROFILE_NOTICE_PERIOD_DAYS=30
PROFILE_DESIRED_SALARY=0
RUN_INTERVAL_MINUTES=60
MIN_DELAY_SEC=30
MAX_DELAY_SEC=120

# ─── Sources (true/false) ─────────────────────────────────────────
ENABLE_LINKEDIN_SEARCH=true
ENABLE_INDEED=true
ENABLE_NAUKRIGULF=true
ENABLE_BAYT=true
ENABLE_GULFTALENT=true
ENABLE_REMOTEOK=true
ENABLE_COMPANY_CAREERS=true

# ─── Follow-ups ───────────────────────────────────────────────────
ENABLE_FOLLOWUP=true
FOLLOWUP_DAYS=7

# ─── Optional ─────────────────────────────────────────────────────
# Send daily summary to your inbox at this hour (24h local)
DAILY_SUMMARY_HOUR=9
LOG_LEVEL=INFO

# ─── AI providers (free tier) ─────────────────────────────────────
# JobyBots uses Google Gemini AI to score and tailor every job match.
# Both keys below are FREE — you only need ONE of them.
#
# 1. Google Gemini (recommended, 60 req/min, 1500/day free):
#    → https://aistudio.google.com/apikey  (sign in with Google → "Get API key")
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
#
# 2. Groq (optional fallback, very fast, free):
#    → https://console.groq.com/keys  (sign up free → create key)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
#
# Master switch — set to false to disable all LLM calls (the bot still
# works on keyword scoring, just less smart matching).
AI_ENABLED=true
# Drop jobs below this AI match score (0-100). 60 is a balanced default.
AI_MIN_MATCH=60

# ─── Email finder v2 ──────────────────────────────────────────────
# Tier of recruiter-email discovery:
#   off  -> only use addresses listed in markets/*.json (safest)
#   t1   -> + scrape the company's own careers/contact page for mailto
#   t2   -> + use LinkedIn cookie to look up the recruiter who posted the job
#   t3   -> + try country-aware patterns (careers@<co>.<tld>) with SMTP gating
EMAIL_FINDER_TIER=t2

# When true, every candidate address is checked via SMTP RCPT probe BEFORE
# we attempt to actually send. Drops obvious 5xx bounces upfront.
SMTP_PROBE_ENABLED=true

# Optional: your LinkedIn `li_at` session cookie. Required for EMAIL_FINDER_TIER=t2.
# Chrome devtools -> Application -> Cookies -> https://www.linkedin.com -> li_at.
# NEVER commit this. The bot caps usage at LINKEDIN_FINDER_DAILY_CAP/day.
LINKEDIN_COOKIE=
LINKEDIN_FINDER_DAILY_CAP=30

# ─── Security ─────────────────────────────────────────────────────
# Never share .env or commit it to Git. Run SECURITY_CHECK.bat after install.
# Use a Gmail App Password only: https://myaccount.google.com/apppasswords
