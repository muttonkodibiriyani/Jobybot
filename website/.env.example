# ── Site ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://jobybots.com
NEXT_PUBLIC_SUPPORT_EMAIL=tharakesh.iitp@gmail.com
NEXT_PUBLIC_SUPPORT_PHONE=+91 7989931325

# ── Stripe (international card payments) ────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...

# ── India / UPI payment (PhonePe / GPay / Paytm) ────────────────────
# The QR image is already shipped at /phonepe-qr.png — replace it with
# your own PhonePe QR if/when the merchant account changes.
NEXT_PUBLIC_UPI_PAYEE_NAME=DARAPU THARAKESWARA REDDY
NEXT_PUBLIC_INR_PRICE=2999
NEXT_PUBLIC_INR_DISPLAY=₹2,999

# Optional: also encode VPA into a backup dynamic QR (not used in the UI today).
NEXT_PUBLIC_UPI_VPA=

# ── Order / refund storage ─────────────────────────────────────────
# Local SQLite path (used when no Vercel KV/Redis env vars are set).
ORDERS_DB_PATH=./data/orders.db

# Vercel KV / Upstash Redis — when set, used instead of SQLite (production).
# KV_REST_API_URL=https://...
# KV_REST_API_TOKEN=...

# ── Gmail SMTP for admin notify + customer delivery + refunds ──────
GMAIL_ADDRESS=tharakesh.iitp@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
GMAIL_FROM_NAME=JobyBots Team

# ── Admin auth ─────────────────────────────────────────────────────
# Long random string. Rotate immediately if the suspicious-login alert fires.
ADMIN_PASSWORD=change-me-now-please

# ── Cron secret (Vercel /api/cron/notify-pending) ──────────────────
CRON_SECRET=use-a-32-char-random-here

# ── Where the installer ZIP lives ──────────────────────────────────
INSTALLER_DOWNLOAD_URL=https://jobybots.com/Jobybot-Pro-Setup.zip

# ── Demo video (YouTube/Vimeo embed URL) ───────────────────────────
