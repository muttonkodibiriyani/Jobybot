# Site URL (production: https://yourdomain.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Stripe (international card payments) ────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...

# ── India / UPI payment ─────────────────────────────────────────────
# Your UPI VPA (e.g. yourname@okhdfcbank, yourname@ybl)
NEXT_PUBLIC_UPI_VPA=yourname@okhdfcbank
NEXT_PUBLIC_UPI_PAYEE_NAME=Jobybot
NEXT_PUBLIC_INR_PRICE=2999
# Currency symbol shown to user
NEXT_PUBLIC_INR_DISPLAY=₹2,999

# ── Order storage ───────────────────────────────────────────────────
# Where to save submitted screenshots in dev. In prod (Vercel) we email them.
ORDERS_DB_PATH=./data/orders.db

# ── Gmail for sending order notifications + delivery to customer ───
GMAIL_ADDRESS=youremail@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
GMAIL_FROM_NAME=Jobybot Team

# ── Admin auth (verification dashboard) ────────────────────────────
ADMIN_PASSWORD=change-me-now-please

# ── Where the post-payment installer lives (signed URL or public) ──
INSTALLER_DOWNLOAD_URL=https://yourdomain.com/Jobybot-Pro-Setup.zip
